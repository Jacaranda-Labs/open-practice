{
  "name": "open-practice",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../apps/web/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TUTOR_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "LEARNING_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_ENABLED": "true",
    "AI_PROVIDER_ORDER": "groq,cloudflare,pollinations",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "CLOUDFLARE_MODEL": "",
    "POLLINATIONS_MODEL": "",
    "APPROVED_MODELS": "groq:openai/gpt-oss-20b",
    // empty = derive the object from a stable name inside this account's namespace
    "DB_OBJECT_ID": "",
    "OUTREACH_ENABLED": "true",
    "OUTREACH_SEND_ENABLED": "true",
    "OUTREACH_DAILY": "50",
    "POSTAL_ADDRESS": "Jacaranda Labs, P.O. Box 900, Bulawayo, Zimbabwe"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEARNER_DB",
        "class_name": "LearnerDatabase"
      }
    ]
  },
  "migrations": [
    {
      // fresh namespace on the open-practice account: this deploy creates the class
      "tag": "v1-learners",
      "new_sqlite_classes": [
        "LearnerDatabase"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
